backend/.env
.visual-scan-cookies.txt
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime SQLite archive
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm


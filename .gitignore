# Generated and temporary project artifacts
_ds/
uploads/
.thumbnail
*.tmp
*.temp

# Optional OCR models are machine-local; baseline fast models are tracked below
frontend/assets/tessdata/**/*.traineddata
frontend/assets/tessdata/**/*.traineddata.gz
frontend/assets/tessdata/manifest.json

# Baseline browser OCR works immediately after clone
!frontend/assets/tessdata/fast/eng.traineddata
!frontend/assets/tessdata/fast/rus.traineddata
!frontend/assets/tessdata/manifest.json


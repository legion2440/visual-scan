{
  "version": 1,
  "application": {
    "entrypoint": "backend/app/main.py",
    "factory": "backend/app/factory.py",
    "api_router": "backend/app/api/router.py"
  },
  "features": {
    "health": {
      "entrypoint": "backend/app/features/health/router.py",
      "contracts": [
        "backend/app/features/health/schemas.py"
      ],
      "owns": [
        "backend health reporting"
      ],
      "depends_on": [
        "backend/app/core/config.py"
      ],
      "tests": [
        "backend/tests/test_health.py"
      ]
    },
    "ocr": {
      "entrypoint": "backend/app/features/ocr/router.py",
      "contracts": [
        "backend/app/features/ocr/schemas.py"
      ],
      "implementation": [
        "backend/app/features/ocr/service.py",
        "backend/app/features/ocr/pipeline.py",
        "backend/app/features/ocr/pdf_pipeline.py",
        "backend/app/features/ocr/pdf_renderer.py",
        "backend/app/features/ocr/preprocessing.py",
        "backend/app/features/ocr/provider.py",
        "backend/app/features/ocr/errors.py"
      ],
      "owns": [
        "server-side image validation",
        "server-side PDF validation and rendering",
        "server-side preprocessing",
        "Tesseract OCR"
      ],
      "depends_on": [
        "backend/app/core/config.py"
      ],
      "tests": [
        "backend/tests/test_ocr_api.py",
        "backend/tests/test_ocr_pipeline.py",
        "backend/tests/test_pdf_ocr_api.py",
        "backend/tests/test_pdf_ocr_pipeline.py",
        "backend/tests/test_pdf_renderer.py",
        "backend/tests/test_tesseract_provider.py"
      ]
    },
    "analysis": {
      "entrypoint": "backend/app/features/analysis/router.py",
      "contracts": [
        "backend/app/features/analysis/schemas.py"
      ],
      "implementation": [
        "backend/app/features/analysis/service.py",
        "backend/app/features/analysis/pipeline.py",
        "backend/app/features/analysis/provider.py",
        "backend/app/features/analysis/prompts.py",
        "backend/app/features/analysis/errors.py"
      ],
      "owns": [
        "AI document classification",
        "AI document summaries",
        "AI structured field extraction",
        "OpenAI-compatible provider integration"
      ],
      "depends_on": [
        "backend/app/core/config.py"
      ],
      "tests": [
        "backend/tests/test_analysis_api.py",
        "backend/tests/test_analysis_pipeline.py",
        "backend/tests/test_openai_compatible_provider.py"
      ]
    },
    "scans": {
      "entrypoint": "backend/app/features/scans/router.py",
      "contracts": [
        "backend/app/features/scans/schemas.py"
      ],
      "implementation": [
        "backend/app/features/scans/service.py",
        "backend/app/features/scans/repository.py",
        "backend/app/features/scans/schema.py",
        "backend/app/features/scans/errors.py"
      ],
      "owns": [
        "server-side scan archive",
        "SQLite scan persistence",
        "scan search, filtering, sorting, and pagination"
      ],
      "depends_on": [
        "backend/app/core/config.py",
        "backend/app/features/analysis/schemas.py",
        "backend/app/features/ocr/schemas.py"
      ],
      "tests": [
        "backend/tests/test_scans_api.py",
        "backend/tests/test_scans_service.py",
        "backend/tests/test_sqlite_scan_repository.py"
      ]
    }
  }
}

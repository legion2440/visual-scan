{
  "version": 1,
  "application": {
    "entrypoint": "backend/app/main.py",
    "factory": "backend/app/factory.py",
    "api_router": "backend/app/api/router.py"
  },
  "features": {
    "health": {
      "entrypoint": "backend/app/features/health/router.py",
      "contracts": [
        "backend/app/features/health/schemas.py"
      ],
      "owns": [
        "backend health reporting"
      ],
      "depends_on": [],
      "tests": [
        "backend/tests/test_health.py"
      ]
    },
    "ocr": {
      "entrypoint": "backend/app/features/ocr/router.py",
      "contracts": [
        "backend/app/features/ocr/schemas.py"
      ],
      "implementation": [
        "backend/app/features/ocr/service.py",
        "backend/app/features/ocr/pipeline.py",
        "backend/app/features/ocr/pdf_pipeline.py",
        "backend/app/features/ocr/pdf_renderer.py",
        "backend/app/features/ocr/preprocessing.py",
        "backend/app/features/ocr/provider.py",
        "backend/app/features/ocr/errors.py"
      ],
      "owns": [
        "server-side image validation",
        "server-side PDF validation and rendering",
        "server-side preprocessing",
        "Tesseract OCR"
      ],
      "depends_on": [
        "backend/app/core/config.py"
      ],
      "tests": [
        "backend/tests/test_ocr_api.py",
        "backend/tests/test_ocr_pipeline.py",
        "backend/tests/test_pdf_ocr_api.py",
        "backend/tests/test_pdf_ocr_pipeline.py",
        "backend/tests/test_pdf_renderer.py",
        "backend/tests/test_tesseract_provider.py"
      ]
    }
  }
}
